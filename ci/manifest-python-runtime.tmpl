# Joins the per-architecture maji-python-runtime images from .drone.yml into one multi-arch
# image. With auto_tag, build.tags is the release's version tags (0.1, 0.1.0).
image: ghcr.io/scanner/maji-python-runtime:{{trimPrefix "v" build.tag}}
{{#if build.tags}}
tags:
{{#each build.tags}}
  - {{this}}
{{/each}}
{{/if}}
manifests:
  - image: ghcr.io/scanner/maji-python-runtime:{{trimPrefix "v" build.tag}}-linux-amd64
    platform:
      architecture: amd64
      os: linux
  - image: ghcr.io/scanner/maji-python-runtime:{{trimPrefix "v" build.tag}}-linux-arm64
    platform:
      architecture: arm64
      os: linux
      variant: v8
