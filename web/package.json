{
  "name": "maji-mcp-web",
  "private": true,
  "version": "0.1.0",
  "description": "The control plane's web client: the queue you decide.",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "npm run generate && vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run generate && vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  }
}
